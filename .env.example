# Copy this file to .env.local (which is gitignored) and fill in the values.
# Server-only secrets — never prefix these with VITE_ and never commit real values.

# Google AI Studio (Gemini) API key — used by the "ถ่ายใบสรุปยอด" receipt scanner.
# Create one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

